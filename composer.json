{
    "name": "inhouse/projectsend-sftp",
    "description": "Staff-initiated SFTP transfers from ProjectSend storage to approved servers.",
    "type": "library",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.4",
        "illuminate/bus": "^12.0",
        "illuminate/console": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/encryption": "^12.0",
        "illuminate/filesystem": "^12.0",
        "illuminate/queue": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/validation": "^12.0",
        "illuminate/view": "^12.0",
        "league/flysystem": "^3.0",
        "phpseclib/phpseclib": "^3.0.56"
    },
    "require-dev": {
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "ProjectSendSftp\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ProjectSendSftp\\SftpTransferServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php tests/run.php"
    },
    "config": {
        "sort-packages": true
    }
}
